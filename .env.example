# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL — used for metadataBase, canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://deplogram.app

# Form delivery (src/lib/actions.ts). Each submission is POSTed here as JSON — point it at a
# Zapier/Make webhook, a Google Apps Script web app, Formspree, a Slack incoming webhook, etc.
# Unset in development → entries are logged to the server console. Unset in production → the form shows an error.
WAITLIST_WEBHOOK_URL=
CONTACT_FORM_ENDPOINT=

# Deplogram API used by the app (/dashboard). Empty = same origin.
# The real backend: https://deplogram-backend.vercel.app (Swagger at /api/docs).
NEXT_PUBLIC_API_URL=
# How much of the API the browser mocks (MSW, src/mocks/handlers.ts):
#   enabled  → everything (no backend needed)
#   partial  → only what the backend doesn't serve yet (src/mocks/live-endpoints.ts);
#              set NEXT_PUBLIC_API_URL to the backend
#   (unset)  → nothing; everything goes to NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MOCKING=enabled
