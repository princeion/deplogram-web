# ── Local development ──────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL — used for metadataBase, canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://deplogram.onrender.com

# ── Forms ─────────────────────────────────────────────────────────────────────
# Form delivery (src/lib/actions.ts). Each submission is POSTed here as JSON —
# point it at a Zapier/Make webhook, a Google Apps Script web app, Formspree,
# a Slack incoming webhook, etc.
# Unset in development → entries are logged to the server console.
# Unset in production → the form shows an error.
WAITLIST_WEBHOOK_URL=
CONTACT_FORM_ENDPOINT=

# ── Deplogram API ─────────────────────────────────────────────────────────────
# The real backend (Swagger at /api/docs).
NEXT_PUBLIC_API_URL=https://n8n.devlaws.xyz

# How much of the API the browser mocks (MSW, src/mocks/handlers.ts):
#   enabled  → everything (no backend needed at all)
#   partial  → only what the backend doesn't serve yet (src/mocks/live-endpoints.ts);
#              auth, projects, deployments etc. hit the real backend
#   (unset)  → nothing mocked; everything goes to NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MOCKING=partial
